# Ladli Behna — Environment Configuration Template
# Placeholders only. Copy this to backend/.env and configure your environment.

# PostgreSQL Connection String (PostgreSQL 14+ recommended)
# Local: postgresql://postgres:password@localhost:5432/shieldher
# Cloud (Neon/Supabase): postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/shieldher

# JWT Secret Key for token signing (generate a secure random 32+ character string)
JWT_SECRET_KEY=ladli-behna-hackathon-secret-change-me-in-production-2026

# OpenAI API Key (optional for audio transcript & context analysis)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Twilio SMS Credentials (optional for live SMS dispatch)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Optional Police Liaison SMS Number
POLICE_SMS_NUMBER=
